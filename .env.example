# Database (use SQLite for local dev; Postgres for production)
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Cloudflare Turnstile (signup – “human” check). Create at https://dash.cloudflare.com/ → Turnstile
# Dev: optional; Cloudflare test keys work without a dashboard account.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your_site_key"
TURNSTILE_SECRET_KEY="your_secret_key"

# Map (Mapbox)
NEXT_PUBLIC_MAPBOX_TOKEN="pk.your_mapbox_public_token"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Realtime (Pusher)
NEXT_PUBLIC_PUSHER_KEY="your_key"
PUSHER_APP_ID="your_app_id"
PUSHER_SECRET="your_secret"
PUSHER_CLUSTER="eu"

# Admin (comma-separated emails)
ADMIN_EMAILS="admin@example.com"

# Team broadcaster (shared secret for /broadcast)
BROADCAST_SECRET="your-broadcast-secret-token"

# Optional: Giphy (chat GIF search)
# GIPHY_API_KEY="your_giphy_key"
